{
  "name": "abx",
  "version": "0.1.0",
  "description": "abx - Accelon3 .adb to XML exporter (TypeScript/Bun prototype)",
  "type": "module",
  "bin": { "abx": "./src/cli.ts" },
  "scripts": {
    "export": "bun run src/cli.ts export",
    "inspect": "bun run src/cli.ts inspect",
    "bench": "bun run src/cli.ts bench",
    "test": "bun run test/verify.ts",
    "test:index": "bun run test/index-match.ts",
    "test:small": "bun run tools/make-small.ts D:\\accelon3\\yinshun\\yinshun.adb --docs 10",
    "md2adb": "bun run tools/md2adb.ts",
    "test:backend": "bun run test/backend-cases.test.ts",
    "test:go": "cd ../wails && go test ./...",
    "test:tour": "bun run test/tour.test.ts",
    "test:edit": "bun run test/edit-session.test.ts && bun run test/rebuild-browser.test.ts",
    "test:tour-ui": "bun run tools/tour-test.ts",
    "test:embed": "bun run tools/embed-test.ts --adb ../build/jingang-group.adb",
    "test:notes": "bun run tools/embed-test.ts --adb ../build/taisho-study.adb --dep build/taisho-85.adb --dep-wait 30000",
    "test:selection": "bun run tools/selection-test.ts --adb ../build/jingang-group.adb",
    "build:viewer": "bun run tools/build-viewer.ts",
    "build:notes": "bun run ../jingqun/notes.ts && bun run ../jingqun/build-notes.ts",
    "build:tours": "bun run tools/build-tours.ts",
    "cases": "bun run tools/make-search-cases.ts",
    "clean": "bun run tools/clean.ts",
    "sync:norms": "bun run tools/sync-agent-norms.ts",
    "check:norms": "bun run tools/sync-agent-norms.ts --check"
  },
  "engines": { "bun": ">=1.1" },
  "license": "Apache-2.0"
}

