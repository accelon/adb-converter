# 中間產物、參考檔案一律不上傳
*.adb
*.xml
*.bin
*.tsv
build/
ts/build/
ts/.cache-codemirror/
node_modules/
accelon3/
*.log
*.tmp
*.zip
*.7z

# 官網（www/）：index.html 與 img/ 進版控；下載檔是發佈產物，由
# `bun run tools/release.ts` 從 build 出來的 exe 重新打包，不進 git（一個 7 MB）
www/*.7z

# 部署憑證（帳密）：只留在本機，絕不進版控
.local/

# Delphi 參考原始碼（非本次產出，保留在本機）
sourcecode/

# Unihan 原始資料（繁簡通檢的來源；手動下載，不進 git）
#   https://github.com/CNMan/Unicode/blob/master/Unihan/Unihan_Variants.txt
# 產物 ts/src/accelon26/variant-data.ts 有 commit，建置不需要 vendor/
vendor/
# 編輯器與 bzip2 wasm 是單檔 HTML 的執行期檔案（不是開發草稿），要進版控
!ts/src/vendor/
ts/src/vendor/*
!ts/src/vendor/bzip2.js
!ts/src/vendor/codemirror/
!ts/src/vendor/codemirror/**
!ts/src/vendor/bzip2-wasm/
!ts/src/vendor/bzip2-wasm/**

# 匯出／測試產物
*_small/
*-small/
*-small.adb
*-small-report.json
report-fgdict.md

# 建置產物：Windows 資源檔（由 ts/tools/release.ts 從 logo128.png 產生）
wails/*.syso
wails/wails.exe
build/windows/
build/darwin/
